{
  "name": "sote",
  "private": true,
  "version": "0.0.1-dev",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:core": "pnpm --filter @sote/core build",
    "build": "pnpm build:core && pnpm --filter @sote/server build && pnpm --filter @sote/web build",
    "typecheck": "pnpm build:core && pnpm -r typecheck",
    "test": "pnpm build:core && pnpm -r test",
    "dev": "pnpm --filter @sote/web dev",
    "check": "node scripts/check-migrations.mjs && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  }
}
