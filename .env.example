# Kopieren nach .env und ausfüllen.

# Pflicht: ohne dieses Kennwort startet compose nicht.
SOTE_DB_PASSWORD=

# Welches Abbild. Vorgabe ist :main, weil es noch kein Release gibt — eine
# Vorgabe auf :latest gäbe beim Pullen einen 404, und das liest sich wie ein
# kaputtes Deployment. Für einen festen Stand hier eine Version eintragen.
# SOTE_IMAGE=ghcr.io/markusthiel/sote:main

# Wo der Server hört. Vorgabe bindet nur an localhost — davor gehört ein
# Reverse Proxy mit TLS, weil der Sitzungskeks sonst im Klartext reist.
SOTE_BIND=127.0.0.1:8080

# Wie lange eine Sitzung gilt.
SOTE_SESSION_DAYS=30

# Minuten ohne Hinsehen, bevor die Erinnerungsmail geht.
# 0 heißt „sofort mailen", nicht „nie".
SOTE_REMINDER_MAIL_AFTER_MINUTES=10
