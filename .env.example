# SOTE — Einstellungen. Kopieren nach `.env` und den einen Pflichtwert füllen.
#
# Aufgebaut wie SONEs `.env.example`, damit beide auf demselben Rechner nicht
# zwei verschiedene Sprachen sprechen.

# --- Pflicht ------------------------------------------------------------

# Kennwort der Datenbank. Wird nur zwischen den beiden Containern benutzt.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Empfohlen ----------------------------------------------------------

# Host-Port. 3001, weil SONE 3000 nimmt.
#
# Gebunden wird an alle Schnittstellen. Davor gehört ein Reverse Proxy mit TLS:
# der Sitzungskeks reist sonst im Klartext. Nur lokal erreichbar wird es, indem
# man in `docker-compose.yml` `127.0.0.1:3001:8080` schreibt — dafür gibt es
# absichtlich keine eigene Variable, weil eine Bindeadresse in einer
# Portangabe zwei Dinge in einem Wert wären.
SOTE_PORT=3001

# Welches Abbild. Vorgabe ist `:main`, weil es noch kein Release gibt — eine
# Vorgabe auf `:latest` gäbe beim Pullen einen 404, und das liest sich wie ein
# kaputtes Deployment. Für einen festen Stand hier eine Version eintragen.
# SOTE_IMAGE=ghcr.io/markusthiel/sote:main

# --- Optional -----------------------------------------------------------

# Wie lange eine Sitzung gilt.
SOTE_SESSION_DAYS=30

# Minuten ohne Hinsehen, bevor die Erinnerungsmail geht.
# `0` heißt „sofort mailen", nicht „nie".
SOTE_REMINDER_MAIL_AFTER_MINUTES=10

# Was hier steht und in `docker-compose.yml` nicht namentlich genannt ist,
# erreicht den Container nie: Compose gibt die Umgebung des Rechners nicht
# weiter. In SONE waren vierzehn Variablen in diesem Zustand, und das Ausfüllen
# hatte keine Wirkung, ohne dass irgendetwas es gesagt hätte.
