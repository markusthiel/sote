# SOTE — Einstellungen. Kopieren nach `.env` und den einen Pflichtwert füllen.
#
# Für jede Variable steht hier, **was ohne sie passiert**. Das ist beim
# Einrichten die einzige Auskunft, die zählt: „optional" sagt nichts darüber,
# was man verliert.
#
# Diese Datei, `docker-compose.yml` und der Code müssen zusammenpassen — und sie
# taten es nicht: zehn Variablen wurden gebaut und hier nie eingetragen. Ein
# Wächter im Prüflauf (`scripts/check-env-passed.mjs`) hält jetzt alle drei
# Stellen zusammen, weil ein Grundsatz, an den sich niemand hält, ein Grundsatz
# mit einer Prüfung zu wenig ist.
#
# Was SOTE im Vergleich zu SONE **nicht** hat und warum, steht im README unter
# „Was SOTE nicht liest".

# --- Pflicht ------------------------------------------------------------

# Kennwort der Datenbank. Wird nur zwischen den beiden Containern benutzt.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Ohne diese fehlen ganze Bereiche -----------------------------------

# Die Adresse, unter der SOTE erreichbar ist. Ohne sie: **keine
# Einladungsmail und kein Single-Sign-on.**
#
# Beide brauchen einen Rückweg, und der darf nicht aus der Anfrage kommen: wer
# die `Host`-Kopfzeile fälscht, lässt diesen Server Links auf einen fremden
# Namen verschicken. Ohne Schrägstrich am Ende.
SOTE_BASE_URL=

# Steht ein Reverse Proxy davor, der `X-Forwarded-For` setzt? Dann `1`, und
# die Drossel gegen Kennwortraten zählt je Herkunft statt je Proxy. Ohne Proxy
# leer lassen: den Kopf kann sonst jeder Aufrufer selbst schreiben und sich
# damit eine Herkunft aussuchen.
SOTE_TRUST_PROXY=

# Der Schlüssel für Freigabe- und Einladungslinks. Ohne ihn gibt es **keine
# Freigaben und keine Einladungslinks** — die Bildschirme sagen das und nennen
# diesen Befehl:
#   openssl rand -hex 32
#
# In der Umgebung und nicht in der Datenbank: läge er neben den Links, die er
# schützt, wäre er keiner. Er schützt gegen Sicherungen, Auszüge und
# Protokolle — nicht gegen jemanden, der Datenbank *und* Umgebung hat, denn der
# hat die Daten ohnehin.
#
# **Tauschen kostet die Klartexte**: bestehende Links funktionieren weiter (das
# Nachschlagen läuft über einen Hash), aber sie lassen sich nicht mehr anzeigen.
# Sichtbar bleiben sie, damit man sie zurücknehmen kann.
SOTE_SHARE_KEY=

# --- Anhänge ------------------------------------------------------------
# Wohin Anhänge gehen, IM CONTAINER. Der Compose-Standard ist /data/files auf
# einem eigenen Datenträger. Fehlt die Variable, nimmt der Server keine
# Anhänge an und die Oberfläche zeigt kein Feld dafür — lieber gar nicht als
# ein Feld, das nichts tut.
#
# Wichtig: die Bytes liegen NICHT in der Datenbank. Ein Abzug der Datenbank
# allein reicht damit nicht zum Wiederherstellen; dieses Verzeichnis gehört
# in dieselbe Sicherung.
SOTE_FILES_DIR=/data/files

# Obergrenze je Datei in MB. Leer heißt 25 — wie ein üblicher Mailanhang.
SOTE_FILE_MAX_MB=

# --- Mailweg ------------------------------------------------------------
#
# Ohne `SOTE_SMTP_HOST` und `SOTE_MAIL_FROM` geht **keine Mail**. Einladen
# funktioniert trotzdem: der Link steht in der Liste zum Weitergeben von Hand.
# **Erinnerungen laufen dann gar nicht**, und der Server sagt es beim Start —
# ein Bearbeiter, der ohne seinen Ausgang läuft, verbrauchte die Quittungen für
# Briefe, die niemand zustellt.

SOTE_SMTP_HOST=
SOTE_MAIL_FROM=

# 587 (STARTTLS) oder 465 (von Anfang an verschlüsselt).
SOTE_SMTP_PORT=587

# Leer heißt: ohne Anmeldung beim Mailserver.
SOTE_SMTP_USER=
SOTE_SMTP_PASS=

# Leer heißt: aus dem Port abgeleitet — 465 ja, sonst STARTTLS. Abgeleitet und
# nicht als dritte Angabe, die zu den beiden anderen passen muss.
# SOTE_SMTP_SECURE=

# --- Single-Sign-on (OIDC) ----------------------------------------------
#
# Alle drei oder keines. Ohne sie fehlt der Knopf auf der Anmeldemaske — er
# fehlt, statt in einen Fehler zu führen.
#
# `https` ist Pflicht, auch „nur im Netz drinnen": über diese Verbindung geht
# das Client-Geheimnis. Beim Anbieter einzutragende Rückkehradresse:
#   $SOTE_BASE_URL/api/sso/callback
#
# **SSO meldet an, es lädt nicht ein**: wer hier kein Konto hat, bekommt keines,
# sondern einen Satz. Eine Einladung lässt sich mit SSO annehmen.

SOTE_OIDC_ISSUER=
SOTE_OIDC_CLIENT_ID=
SOTE_OIDC_CLIENT_SECRET=

# Wie der Knopf heißt. Ohne das steht dort „Single-Sign-on", was nichts über
# den Anbieter sagt.
SOTE_OIDC_LABEL=

# --- Betrieb ------------------------------------------------------------

# Host-Port. 32901, im Nachbarfeld von SONEs 32900. Im Container hört der
# Server immer auf 8080.
#
# Gebunden wird an alle Schnittstellen. Davor gehört ein Reverse Proxy mit TLS:
# der Sitzungskeks reist sonst im Klartext. Nur lokal erreichbar wird es, indem
# man in `docker-compose.yml` `127.0.0.1:32901:8080` schreibt — dafür gibt es
# absichtlich keine eigene Variable, weil eine Bindeadresse in einer Portangabe
# zwei Dinge in einem Wert wären.
SOTE_PORT=32901

# Welches Abbild. Vorgabe ist `:main`, weil es noch kein Release gibt — eine
# Vorgabe auf `:latest` gäbe beim Pullen einen 404, und das liest sich wie ein
# kaputtes Deployment. Für einen festen Stand hier eine Version eintragen.
# SOTE_IMAGE=ghcr.io/markusthiel/sote:main

# Wie lange eine Sitzung gilt.
SOTE_SESSION_DAYS=30
